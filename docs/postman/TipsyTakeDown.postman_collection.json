									"    pm.request.headers.add({ key: \"Authorization\", value: `Bearer ${token}` });",
									"    pm.request.headers.add({ key: \"Cookie\", value: `session=${token}` });",
									"",
									"    console.log(\"Token added to request:\", token);",
									"} else {",
